# Copiar a .env y ajustar. (Ojo: la versión "vulnerable" del proyecto no lee
# un .env — las credenciales están escritas en src/config.ts. Eso es justamente
# una de las falhas que hay que corregir.)

NODE_ENV=development
PORT=3000

# Puerto publicado en el host (docker-compose.yml)
APP_PORT=8080

DB_HOST=db
DB_PORT=5432
DB_NAME=origen_ejemplo
DB_USER=origen_app_ejemplo
DB_PASSWORD=origen_app_ejemplo

UPLOADS_DIR=/app/uploads

DB_APP_PASSWORD=origen_app_ejemplo
SESSION_SECRET=<SECRET>
ADMIN_USER=admin
ADMIN_PASSWORD=origen_app_ejemplo

POSTGRES_PASSWORD=origen_app_ejemplo